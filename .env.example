# Google Cloud Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1

# Secret Manager Secret IDs (Used in production before falling back to env vars)
GEMINI_API_KEY_SECRET_ID=gemini-api-key
SEARCH_ENGINE_ID_SECRET_ID=gcp-docs-search-engine-id

# Local Development Fallback Credentials (Never hardcode actual secrets in source code)
GEMINI_API_KEY=your-gemini-api-key-here
GCP_SEARCH_ENGINE_ID=your-vertex-search-datastore-id

# Model Routing Configuration
FAST_MODEL_NAME=gemini-2.5-flash
PRO_MODEL_NAME=gemini-2.5-pro

# Memory & Compaction Configuration
MAX_CONTEXT_TOKENS=4000
SLIDING_WINDOW_TURNS=6

# Telemetry & Guardrails
LOG_LEVEL=INFO
OTEL_SERVICE_NAME=gcp-solutions-advisor-agent
STRICT_GROUNDING_THRESHOLD=0.75
